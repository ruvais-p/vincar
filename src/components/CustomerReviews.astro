---
const reviews = [
  { initials: '01', name: 'A first-time buyer', context: 'Finding the right questions', quote: 'A clear history would help me ask the seller better questions.' },
  { initials: '02', name: 'A buyer with a shortlist', context: 'Looking beyond the listing', quote: 'One clear timeline would make my shortlist easier to compare.' },
  { initials: '03', name: 'A private seller', context: 'Starting a clearer conversation', quote: 'A shared report would help start a more informed conversation.' },
];
---
<section class="reviews-section container" aria-labelledby="reviews-heading" data-reviews>
  <div class="reviews-intro">
    <span class="eyebrow">THE PEOPLE BEHIND THE PURCHASE</span>
    <h2 id="reviews-heading">A little clarity.<br/>A lot of confidence.</h2>
    <p>Every car search has a story. Here’s what a clearer picture could mean along the way.</p>
    <div class="reviews-disclosure"><span class="mini-label">SAMPLE REVIEWS</span><p>Illustrative examples, not actual customer testimonials.</p></div>
  </div>
  <div class="reviews-stage" role="region" aria-roledescription="carousel" aria-label="Sample reviews">
    <div class="reviews-board"><img class="reviews-art" src="/images/Friendly%20man%20lifting%20blank%20review%20board.png" alt="" width="1536" height="1024" loading="lazy" decoding="async"/>
    <div class="reviews-panel" aria-live="polite" aria-atomic="true">
      {reviews.map((review, i) => <figure class="review-slide" data-review hidden={i !== 0} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${reviews.length}`}>
        <figcaption><span class="review-avatar" aria-hidden="true">{review.initials}</span><div><strong>{review.name}</strong><span>{review.context}</span></div></figcaption>
        <blockquote>“{review.quote}”</blockquote>
        <span class="review-sample">SAMPLE REVIEW</span>
      </figure>)}
    </div>
    </div>
    <div class="reviews-controls"><button type="button" data-review-prev aria-label="Previous review">←</button><span data-review-position aria-hidden="true">01 / 03</span><button type="button" data-review-next aria-label="Next review">→</button></div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach(section => {
    const slides = Array.from(section.querySelectorAll<HTMLElement>('[data-review]'));
    const position = section.querySelector('[data-review-position]');
    let current = 0;
    const show = (step: number) => {
      current = (current + step + slides.length) % slides.length;
      slides.forEach((slide, index) => { slide.hidden = index !== current; });
      if (position) position.textContent = `${String(current + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
    };
    section.querySelector('[data-review-prev]')?.addEventListener('click', () => show(-1));
    section.querySelector('[data-review-next]')?.addEventListener('click', () => show(1));
  });
</script>
<style>
  .reviews-section{display:grid;grid-template-columns:.65fr 1.35fr;align-items:center;gap:24px;padding-block:72px;border-block:1px solid var(--line)}
  .reviews-intro h2{font-size:clamp(32px,3.2vw,46px)}
  .reviews-intro>p{max-width:370px;margin-bottom:30px}
  .reviews-disclosure{border-left:2px solid var(--accent);padding-left:16px}
  .reviews-disclosure p{font-size:12px;max-width:260px;margin:6px 0 0}
  .reviews-stage{position:relative;min-width:0;container-type:inline-size}
  .reviews-board{position:relative}
  .reviews-art{display:block;width:100%;height:auto}
  /* The text stays within the painted board, preserving the full illustration. */
  .reviews-panel{position:absolute;left:27%;right:5%;top:15%;height:53%;display:grid;align-items:center}
  .review-slide{margin:0;animation:review-in .25s ease-out}
  .review-slide[hidden]{display:none}
  figcaption{display:flex;gap:12px;align-items:center;margin-bottom:clamp(8px,2cqw,18px)}
  .review-avatar{width:38px;height:38px;flex-shrink:0;display:grid;place-items:center;background:var(--accent);border-radius:50%;font-size:12px;font-weight:700}
  figcaption strong{display:block;font-size:clamp(12px,2.2cqw,17px);line-height:1.3}
  figcaption div>span{display:block;font-size:12px;color:var(--muted)}
  blockquote{font-size:clamp(12px,2.8cqw,22px);line-height:1.45;margin:0 0 clamp(5px,1.6cqw,16px);letter-spacing:-.01em}
  .review-sample{display:block;font-size:clamp(8px,1.2cqw,10px);font-weight:700;letter-spacing:.1em;color:var(--muted)}
  .reviews-controls{display:flex;justify-content:center;align-items:center;gap:18px;margin-top:8px}
  .reviews-controls button{width:46px;height:46px;border:1px solid var(--ink);border-radius:50%;background:var(--canvas);font-size:22px;transition:background .18s,transform .18s}
  .reviews-controls button:hover{background:var(--accent);transform:translateY(-2px)}
  .reviews-controls>span{font-size:12px;letter-spacing:.1em;font-variant-numeric:tabular-nums}
  @keyframes review-in{from{opacity:0;transform:translateX(6px)}to{opacity:1;transform:translateX(0)}}
  @media(max-width:1000px){.reviews-section{grid-template-columns:1fr;gap:24px}.reviews-intro{max-width:600px}.reviews-intro>p{max-width:none}.reviews-stage{width:100%;max-width:800px;justify-self:center}}
  @media(max-width:650px){.reviews-section{padding-block:48px}.reviews-intro h2{font-size:34px}}
  @container(max-width:480px){.review-avatar,figcaption div>span{display:none}figcaption{margin-bottom:6px}.reviews-panel{top:14%;height:50%}}
  @media(prefers-reduced-motion:reduce){.review-slide{animation:none}.reviews-controls button{transition:none}}
</style>
