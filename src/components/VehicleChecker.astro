---
import {config,plans,money} from '../lib/config';
import Icon from './Icon.astro';
const {initialTab='vin'}=Astro.props;
---
<div class="checker" id="checker"><div class="checker-heading"><span class="mini-label">YOUR NEXT CAR, A LITTLE CLEARER</span><span class="outline-icon"><Icon name="search" size={20}/></span></div><h2>Start with its history.</h2><p class="muted">One small check. A more informed decision.</p>
<div class="checker-tabs" role="tablist" aria-label="Search method"><button id="vin-tab" role="tab" aria-selected={initialTab==='vin'?'true':'false'} aria-controls="vin-panel" tabindex={initialTab==='vin'?0:-1} data-kind="vin">By VIN</button><button id="plate-tab" role="tab" aria-selected={initialTab==='plate'?'true':'false'} aria-controls="plate-panel" tabindex={initialTab==='plate'?0:-1} data-kind="plate">By license plate</button></div>
<form id="vehicle-form" action="/api/search/" method="post" novalidate><input type="hidden" name="kind" value={initialTab}/><div class="checker-panels"><div id="vin-panel" role="tabpanel" aria-labelledby="vin-tab" hidden={initialTab!=='vin'}><div class="field-label"><label for="vin">Vehicle identification number</label><span id="vin-count">0 / 17</span></div><input id="vin" name="vin" autocomplete="off" spellcheck="false" placeholder="Enter your 17-character VIN" aria-describedby="vin-hint search-error" disabled={initialTab!=='vin'}/><div class="field-help" id="vin-hint"><span>17 characters. No I, O, or Q.</span><button class="text-button" type="button" id="vin-help">Where’s my VIN?</button></div></div><div id="plate-panel" role="tabpanel" aria-labelledby="plate-tab" hidden={initialTab!=='plate'}><div class="plate-fields"><div><label for="plate">License plate number</label><input id="plate" name="plate" autocomplete="off" spellcheck="false" placeholder="Enter license plate" aria-describedby="plate-hint search-error" disabled={initialTab!=='plate'}/></div><div><label for="state">Registration state</label><select id="state" name="state" disabled={initialTab!=='plate'}><option value="">Choose a state</option>{config.states.map(s=><option value={s}>{s}</option>)}</select></div></div><p class="small" id="plate-hint">US passenger vehicles. Specialty formats may need a VIN.</p></div></div><p id="search-error" class="error" role="alert" hidden></p><button class="button primary submit-check" type="submit">Check vehicle <Icon name="arrow" size={21}/></button><div class="checker-price"><Icon name="lock" size={15}/><span>Full reports from <strong>{money(plans[0].cents)}</strong> · <a href="/pricing/">See pricing</a></span></div><p class="small centered">Identity preview first. Full vehicle history is paid.</p>
<details class="demo-options"><summary>Try the demo with sample input <span>＋</span></summary><button type="button" class="text-button" id="fill-demo">Use an example VIN ↗</button><label for="scenario">Demo outcome</label><select id="scenario" name="scenario"><option value="available">Sample records available</option><option value="identified">Identity only; coverage unconfirmed</option><option value="no-match">No matching vehicle</option><option value="unsupported">Unsupported market</option><option value="failed">Temporary provider failure</option><option value="fulfillment-failed">Paid fulfillment failure</option></select></details></form><noscript><p class="small">The form works without JavaScript. Use the VIN tool for a VIN search or the plate lookup tool for plates.</p></noscript></div>
<dialog id="vin-dialog" aria-labelledby="vin-dialog-title"><button class="dialog-close secondary" aria-label="Close VIN guidance">✕</button><span class="eyebrow">A QUICK POINTER</span><h2 id="vin-dialog-title">Where’s my VIN?</h2><p>Look through the windshield at the driver-side dashboard, or check the label inside the driver-side door frame. It may also appear on the vehicle’s title, registration, or insurance documents.</p><p>Most US vehicles made from 1981 use 17 characters. Earlier vehicles may need a specialist lookup.</p><button class="button primary dialog-done">Got it</button></dialog>
<script>
 import {validate} from '../lib/validation';
 import {track} from '../lib/analytics';
 const form=document.querySelector<HTMLFormElement>('#vehicle-form')!;
 const tabs=[...document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-kind]')];
 const vin=document.querySelector<HTMLInputElement>('#vin')!;
 const error=document.querySelector<HTMLElement>('#search-error')!;
 const submit=form.querySelector<HTMLButtonElement>('[type="submit"]')!;
 const dialog=document.querySelector<HTMLDialogElement>('#vin-dialog')!;
 const help=document.querySelector<HTMLButtonElement>('#vin-help')!;
 function switchTab(kind:string){tabs.forEach(tab=>{const selected=tab.dataset.kind===kind;tab.setAttribute('aria-selected',String(selected));tab.tabIndex=selected?0:-1;const panel=document.getElementById(`${tab.dataset.kind}-panel`)!;panel.hidden=!selected;panel.querySelectorAll<HTMLInputElement|HTMLSelectElement>('input,select').forEach(i=>i.disabled=!selected);});(form.elements.namedItem('kind') as HTMLInputElement).value=kind;error.hidden=true;}
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>switchTab(tab.dataset.kind!));tab.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(e.key)){e.preventDefault();const next=e.key==='Home'?0:e.key==='End'?1:(i+1)%2;switchTab(tabs[next].dataset.kind!);tabs[next].focus();}});});
 function count(){document.querySelector('#vin-count')!.textContent=`${vin.value.trim().length} / 17`;}
 vin.addEventListener('input',count);vin.addEventListener('blur',()=>{vin.value=vin.value.trim().toUpperCase();count();});
 form.addEventListener('focusin',()=>track('checker_started'),{once:true});
 document.querySelector('#fill-demo')!.addEventListener('click',()=>{switchTab('vin');vin.value='1HGCM82633A004352';count();vin.focus();});
 help.addEventListener('click',()=>dialog.showModal());dialog.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>dialog.close()));dialog.addEventListener('close',()=>help.focus());
 const saved=sessionStorage.getItem('vehicle-input');if(saved){try{const data=JSON.parse(saved);vin.value=data.vin||'';(document.querySelector('#plate') as HTMLInputElement).value=data.plate||'';(document.querySelector('#state') as HTMLSelectElement).value=data.state||'';if(data.kind)switchTab(data.kind);count();}catch{/* Ignore invalid local draft. */}}
 form.addEventListener('submit',async e=>{e.preventDefault();if(submit.disabled)return;const data=new FormData(form);const kind=String(data.get('kind'));const raw=String(data.get(kind)||'');const result=validate(kind,raw,String(data.get('state')||''));if(result.error){track('validation_failed');error.textContent=result.error;error.hidden=false;const input=form.querySelector<HTMLInputElement>(`#${kind}`)!;input.setAttribute('aria-invalid','true');input.focus();return;}
 form.querySelectorAll('[aria-invalid]').forEach(i=>i.removeAttribute('aria-invalid'));sessionStorage.setItem('vehicle-input',JSON.stringify({kind,vin:vin.value,plate:(document.querySelector('#plate') as HTMLInputElement).value,state:(document.querySelector('#state') as HTMLSelectElement).value}));submit.disabled=true;submit.textContent='Checking…';error.hidden=true;
 try{const response=await fetch('/api/search/',{method:'POST',body:data,headers:{Accept:'application/json'}});const body=await response.json();if(!response.ok)throw new Error(body.error||'We could not complete your search. Please try again.');track('search_submitted');window.location.assign(body.url);}catch(e){error.textContent=e instanceof Error?e.message:'Connection interrupted. Please retry.';error.hidden=false;submit.disabled=false;submit.textContent='Check vehicle →';}});
</script>
