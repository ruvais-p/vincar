---
import {config} from '../lib/config';
import Layout from '../layouts/Layout.astro';
import VehicleChecker from '../components/VehicleChecker.astro';
import Illustration from '../components/Illustration.astro';
import PricingCards from '../components/PricingCards.astro';
import ReportView from '../components/ReportView.astro';
import {publicPages} from '../lib/content';
import {fixture} from '../lib/fixtures';
export function getStaticPaths(){return [...Object.keys(publicPages),'pricing','sample-report','vin-check','vin-decoder','license-plate-lookup'].map(page=>({params:{page}}));}
const {page}=Astro.params;
const tools:Record<string,{title:string;description:string}>={'vin-check':{title:'Every vehicle has a history. Start here.',description:'Check the structure of a VIN and explore a clearly labelled demo vehicle-history flow.'},'vin-decoder':{title:'Start with the VIN.',description:'Understand a vehicle identifier before digging into its documented history.'},'license-plate-lookup':{title:'Have a plate? Start there.',description:'Enter a US plate and registration state to explore the demo lookup experience.'}};
const content=publicPages[page!];const tool=tools[page!];
const title=content?.title||tool?.title||(page==='pricing'?'A clear price for a clearer picture.':'Take a look inside.');
const description=content?.description||tool?.description||(page==='pricing'?'Transparent one-time demo pricing, credit rules, and billing details.':'Explore a synthetic example of a vehicle history report, with dated records and clear coverage limits.');
const sample={...fixture,id:'sample',owner:'sample',searchId:'sample',generatedAt:'2026-10-01T10:00:00Z'};
---
<Layout title={title} description={description}><div class="container"><div class="page-heading"><div class="breadcrumb"><a href="/">Home</a><span>/ {page?.replaceAll('-',' ')}</span></div><span class="eyebrow">{config.name.toUpperCase()} / {page?.replaceAll('-',' ').toUpperCase()}</span>{page!=='sample-report'&&<h1>{title}</h1>}<p>{description}</p></div>{content&&<div class="content-page prose">{page==='about'&&<Illustration variant="about"/>}{content.sections.map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}<div class="actions"><a class="button primary" href="/#checker">Try the demo checker →</a><a href="/sample-report/">Explore a sample report</a></div></div>}{tool&&<div class="tool-layout"><div><h2>{page==='license-plate-lookup'?'The state matters.':'A small identifier. A useful starting point.'}</h2><p>{page==='license-plate-lookup'?'A plate alone is not a unique vehicle identifier across the United States. A live lookup needs the registration jurisdiction and a licensed matching service.':'Standard modern US VINs contain 17 characters. They exclude I, O, and Q to reduce confusion with numbers. The identifier can describe vehicle attributes, but those attributes alone do not establish its condition or available history.'}</p><h2>What this tool does</h2><p>Validates the input format, then opens an explicitly synthetic preview. It does not decode or check a real vehicle. The demo vehicle’s identity is unrelated to your input.</p><h2>What comes next</h2><p>Confirm identity and coverage in a live service before paying. Here, choose a demo outcome to explore no-match, unsupported-market, and provider-failure states.</p><a href="/coverage/">Read the full coverage explanation ↗</a></div><VehicleChecker initialTab={page==='license-plate-lookup'?'plate':'vin'}/></div>}{page==='pricing'&&<div class="content-page"><PricingCards/><div class="notice">These are proposed launch-test prices. Live pricing, taxes, supplier costs, refund terms, and payment provider remain unconfirmed. No recurring membership is enabled.</div></div>}{page==='sample-report'&&<div class="content-page"><ReportView report={sample} sample/><div class="actions"><a href="/#checker" class="button primary">Try the vehicle checker →</a></div></div>}</div></Layout>
