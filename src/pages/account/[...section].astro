---
export const prerender=false;
import Layout from '../../layouts/Layout.astro';
import {db,activeCredits,saved,outbox} from '../../lib/server';
import {date,money} from '../../lib/config';
const section=Astro.params.section||'reports';
if(!['reports','shortlist','compare','billing','outbox'].includes(section))return new Response('Page not found.',{status:404});
const owner=Astro.locals.owner;
const reports=[...db.reports.values()].filter(r=>r.owner===owner);
const orders=[...db.orders.values()].filter(o=>o.owner===owner);
const list=reports.filter(r=>saved.get(owner)?.has(r.id));
const titles={reports:'My reports',shortlist:'Your saved shortlist',compare:'Compare your reports',billing:'Purchases & credits',outbox:'Your demo delivery outbox'};
const deliveries=[...outbox.values()].filter(x=>x.owner===owner&&!x.used&&x.expires>Date.now());
const user=db.users.get(owner)!;
---
<Layout title={titles[section as keyof typeof titles]} privatePage><div class="container private-page"><span class="eyebrow">KEEP THE BIGGER PICTURE</span><div class="account-summary"><h1>{titles[section as keyof typeof titles]}</h1><span class="state-label">{activeCredits(owner)} report credits remaining</span></div><nav class="account-nav" aria-label="Report account"><a href="/account/" aria-current={section==='reports'?'page':undefined}>My reports</a><a href="/account/shortlist/" aria-current={section==='shortlist'?'page':undefined}>Saved shortlist</a><a href="/account/compare/" aria-current={section==='compare'?'page':undefined}>Compare</a><a href="/account/billing/" aria-current={section==='billing'?'page':undefined}>Purchases & credits</a><a href="/account/outbox/" aria-current={section==='outbox'?'page':undefined}>Demo outbox</a></nav><p class="small">Private demo session. Data is held in memory and disappears on server restart. No live account or email provider is connected.</p>
{['reports','shortlist'].includes(section)&&<>{(section==='reports'?reports:list).length?<div class="report-list">{(section==='reports'?reports:list).map(r=><article class="report-row"><div><span class="mini-label">SYNTHETIC VEHICLE REPORT</span><h3>{r.identity.year} {r.identity.make} {r.identity.model}</h3><p>Generated: {date(r.generatedAt)}</p></div><div class="actions"><a class="button secondary" href={`/reports/${r.id}/`}>Open report →</a><form method="post" action="/api/action/"><input type="hidden" name="action" value="save"/><input type="hidden" name="report" value={r.id}/><button class="text-button">{saved.get(owner)?.has(r.id)?'Remove from shortlist':'Save to shortlist'}</button></form></div></article>)}</div>:<div class="empty-state"><h2>{section==='reports'?'Your next car’s story starts here.':'Keep your contenders together.'}</h2><p>{section==='reports'?'Complete a sandbox purchase to keep a report in this private session.':'Save a purchased report to add it to your shortlist.'}</p><a class="button primary" href="/#checker">Check a vehicle →</a></div>}<div class="actions"><a class="text-link" href="/guides/buying-checklist/">Take the buyer checklist with you ↗</a></div></>}
{section==='reports'&&orders.filter(o=>o.status!=='fulfilled').map(o=><div class="notice"><strong>{o.status==='fulfillment-failed'?'Report delivery needs a retry':'Sandbox order in progress'}</strong><p>Status: {o.status}. No real payment occurred.</p><a href={`/checkout/?order=${o.id}`}>Continue this order →</a></div>)}
{section==='reports'&&reports.length>0&&!user.email&&<div class="empty-state"><h2>Keep a demo profile.</h2><p>Optional, after purchase. This saves an email in your current session only; production account creation and email verification are not connected.</p><form method="post" action="/api/action/"><input type="hidden" name="action" value="account"/><label for="account-email">Email</label><input name="email" id="account-email" type="email" maxlength="254" required/><div class="actions"><button class="button secondary">Save demo profile</button></div></form></div>}
{Astro.url.searchParams.get('profile')==='saved'&&<p role="status" class="notice">Demo profile saved. This is not a verified production account.</p>}
{section==='compare'&&<>{reports.length>=2?<><p>Compare up to three purchased reports. All vehicles in this demo share the same synthetic fixture.</p><div class="table-wrap"><table><caption>Purchased vehicle reports</caption><thead><tr><th scope="col">Category</th>{reports.slice(0,3).map((r,i)=><th scope="col"><a href={`/reports/${r.id}/`}>Vehicle {i+1}</a><br/>{r.identity.year} {r.identity.model}</th>)}</tr></thead><tbody>{reports[0].coverage.map((c,i)=><tr><th scope="row">{c.category}</th>{reports.slice(0,3).map(r=><td>{r.coverage[i].note}</td>)}</tr>)}</tbody></table></div></>:<div class="empty-state"><h2>Two cars. One clearer view.</h2><p>Unlock at least two vehicle reports to compare their recorded findings side by side.</p><a href="/#checker" class="button primary">Check another vehicle →</a></div>}</>}
{section==='billing'&&<><h2>One-time purchases only.</h2><p>No active membership, renewal, or recurring payment. There is nothing to cancel. Sandbox receipts below are not tax invoices.</p>{orders.length?<div class="table-wrap"><table><caption>Sandbox order history</caption><thead><tr><th scope="col">Date</th><th scope="col">Package</th><th scope="col">Total</th><th scope="col">Status</th></tr></thead><tbody>{orders.map(o=><tr><td>{date(o.createdAt)}</td><td>{o.planId}</td><td>{money(o.cents)}</td><td>{o.status}</td></tr>)}</tbody></table></div>:<p class="notice">No purchases in this session.</p>}<h2>Credit ledger</h2><div class="table-wrap"><table><caption>Credit purchases and report deductions</caption><thead><tr><th scope="col">Reason</th><th scope="col">Credits</th><th scope="col">Validity ends</th></tr></thead><tbody>{[...db.ledger.values()].filter(e=>e.owner===owner).map(e=><tr><td>{e.reason}</td><td>{e.delta>0?'+':''}{e.delta}</td><td>{date(e.expiresAt)}</td></tr>)}</tbody></table></div><p class="small">Purchased reports remain accessible in the demo session after a credit is consumed. No refresh or monitoring service is included.</p></>}
{section==='outbox'&&<><p class="notice">Simulated email delivery only. No message was sent. These single-use links expire after 30 minutes and grant access to your demo reports; treat them as private.</p>{deliveries.length?deliveries.map(d=><article class="report-row"><div><h3>Your report is ready</h3><p>To: {db.orders.get(d.orderId)?.email||'Demo credit redemption'}</p><p>Expires: {date(new Date(d.expires).toISOString())}</p></div><a class="button secondary" href={`/account/access/${d.token}/`}>Open secure demo link →</a></article>):<div class="empty-state"><h2>No pending delivery links.</h2><p>Your reports are still accessible from My reports in this session. A new successful sandbox fulfillment creates a delivery link.</p></div>}</>}
</div></Layout>
