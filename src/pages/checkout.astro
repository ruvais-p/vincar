---
export const prerender=false;
import Layout from '../layouts/Layout.astro';
import {db,findReport} from '../lib/server';
import {plans,money} from '../lib/config';
const orderId=Astro.url.searchParams.get('order');
const order=orderId?db.orders.get(orderId):undefined;
if(orderId&&(!order||order.owner!==Astro.locals.owner))return new Response('Order not found.',{status:404});
const search=db.searches.get(order?.searchId||Astro.url.searchParams.get('search')||'');
if(!search||search.owner!==Astro.locals.owner||search.status!=='available')return Astro.redirect('/#checker');
const existing=findReport(Astro.locals.owner,search);if(existing)return Astro.redirect(`/reports/${existing.id}/`);
const plan=plans.find(p=>p.id===(order?.planId||Astro.url.searchParams.get('plan')));
if(!plan)return Astro.redirect(`/search/${search.id}/`);
---
<Layout title="Sandbox checkout" privatePage><div class="container private-page"><div class="breadcrumb"><a href={`/search/${search.id}/`}>Vehicle preview</a><span>/ Sandbox checkout</span></div><span class="eyebrow">A CLEAR NEXT STEP</span><h1>{order?.status==='fulfillment-failed'?'Your order is safe. Let’s retry.':'Your report, without the guesswork.'}</h1><p class="notice">Sandbox checkout — no real payment, card details, or email delivery. Tax is simulated at $0.00; this is not a live tax quote.</p><div class="checkout-layout"><div>{!order?<form class="checkout-form" method="post" action="/api/action/"><h2>Continue as a guest.</h2><p>No account required. In a live service, your report would arrive by a secure email link.</p><input type="hidden" name="action" value="order"/><input type="hidden" name="search" value={search.id}/><input type="hidden" name="plan" value={plan.id}/><label for="email">Email for your report</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="254" required/><p class="small">Demo delivery appears in your private outbox. No message is sent.</p><button class="button primary">Review sandbox order →</button><p class="small">One-time purchase. No recurring billing. Read the <a href="/refund-policy/">demo refund policy</a>.</p></form>:<div><h2>{order.status==='fulfillment-failed'?'Payment simulated. Report pending.':'Ready to try the sandbox?'}</h2><p>{order.status==='fulfillment-failed'?'The sandbox order is preserved. No report credit has been consumed. Retry delivery without another payment.':'This action asks the sandbox adapter to simulate a signed payment callback. Report access is granted only after verified fulfillment.'}</p><p class="small">Delivery address: {order.email}</p><form method="post" action="/api/action/"><input type="hidden" name="action" value={order.status==='fulfillment-failed'?'retry-order':'pay'}/><input type="hidden" name="order" value={order.id}/><button class="button primary">{order.status==='fulfillment-failed'?'Retry report delivery':'Simulate successful payment'} →</button></form><p class="small">No money moves. You can revisit this order in <a href="/account/">My reports</a>.</p></div>}</div><aside class="order-summary"><span class="eyebrow">YOUR SANDBOX ORDER</span><h2>{search.identity?.year} {search.identity?.make}<br/>{search.identity?.model}</h2><p class="identifier">{search.input} {search.state}</p><dl><div><dt>Package</dt><dd>{plan.name}</dd></div><div><dt>Quantity</dt><dd>1 package · {plan.credits} {plan.credits===1?'report':'credits'}</dd></div><div><dt>Billing</dt><dd>One-time</dd></div><div><dt>Subtotal</dt><dd>{money(plan.cents)}</dd></div><div><dt>Simulated tax</dt><dd>$0.00</dd></div><div class="total"><dt>Sandbox total</dt><dd>{money(plan.cents)}</dd></div></dl><p class="small">Credits valid for 12 months. One credit is used for this vehicle after successful delivery. Reopening is free. Refreshes are not included.</p><a class="small" href="/refund-policy/">Delivery & refund policy</a></aside></div></div><script>import {track} from '../lib/analytics';track('checkout_started');document.querySelectorAll('form').forEach(f=>f.addEventListener('submit',()=>{const b=f.querySelector('button');if(b){b.disabled=true;b.textContent='Processing…';}}));</script></Layout>
