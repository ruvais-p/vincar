---
import {config} from '../lib/config';
import Layout from '../layouts/Layout.astro';
import VehicleChecker from '../components/VehicleChecker.astro';
import Icon from '../components/Icon.astro';
import PricingCards from '../components/PricingCards.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import {guides,faqs} from '../lib/content';
const categories=[['car','Damage & accidents','Has it had a difficult past?','Look for recorded incidents and damage, then ask what was repaired.'],['shield','Title brands','What does the title tell me?','Understand recorded salvage, rebuilt, flood, and other title brands.'],['gauge','Mileage','Do the numbers add up?','Compare dated odometer readings and look for gaps or discrepancies.'],['people','Ownership & use','How was it used?','See available registration and use records, without owner identities.'],['alert','Recalls','What needs attention?','Check whether recall information is covered. Live recall data is not connected in this demo.'],['photo','Past listings & photos','What did it look like before?','Earlier listings can add context when a licensed provider makes them available.']];
---
<Layout><section class="hero container"><div class="hero-copy"><div class="eyebrow"><span class="short-rule"></span> BEFORE THE KEYS, THE HISTORY.</div><h1>Know the history<br/>before you <span class="underlined">buy.</span></h1><p class="hero-lede">A great-looking car is only part of the story.<br class="desktop-only"/> Check its recorded history. Ask better questions.<br class="desktop-only"/> Take your next step with more clarity.</p></div><div class="hero-checker"><VehicleChecker/></div><div class="hero-art"><img class="hero-illustration" src="/images/herosection.png" alt="A buyer reviewing the history of an orange car" width="1536" height="1024" decoding="async"/><a class="sample-link" href="/sample-report/"><Icon name="file" size={18}/> Take a look inside a sample report <span>↗</span></a></div></section>
<section class="trust-strip"><div class="container trust-inner"><p>A little more clarity.<br/><strong>A lot less guesswork.</strong></p><span><Icon name="shield"/> Clear coverage, upfront</span><span><Icon name="file"/> Reports you can keep</span><span><Icon name="lock"/> One-time options. No surprises.</span></div></section>
<section class="container about-section section" id="about"><div class="about-copy"><span class="eyebrow">MADE FOR THE MOMENT BEFORE YOU BUY</span><h2>Love the car.<br/>Get to know its past.</h2><p>Before the test drive turns into a decision, get a clearer view of where that car has been.</p><div class="why-row"><span>01 / LOOK</span><p><strong>Look beyond the shine.</strong> Explore available damage, title, and mileage records for details worth a closer look.</p></div><div class="why-row"><span>02 / ASK</span><p><strong>Make every question count.</strong> Bring what you find to the seller or mechanic, and ask about repairs, mileage, and gaps in the story.</p></div><div class="why-row"><span>03 / SHARE</span><p><strong>Start a more informed conversation.</strong> Buying or selling, use the documented history to talk through the car together.</p></div><a class="text-link" href="/sample-report/">Take a look inside a report <Icon name="arrow" size={18}/></a><p class="small inspection-note">A report supports your decision. It doesn’t replace an inspection or guarantee a vehicle’s condition.</p></div><div class="about-art"><span class="art-note">Meet the car behind the listing.</span><img class="about-illustration" src="/images/aboutsection.png" alt="Two people discussing a vehicle history report beside an orange car" width="1536" height="1024" loading="lazy" decoding="async"/><span class="art-caption">Your next chapter starts with its history.</span></div></section>
<section class="categories-section section"><div class="container"><div class="section-intro"><div><span class="eyebrow">LOOK BEYOND THE PAINTWORK</span><h2>Six ways to see<br/>more of the story.</h2></div><p>Know what to look for, what to ask,<br/>and where the gaps might be.<br/><span class="small">Availability varies by vehicle and provider.</span></p></div><div class="category-grid">{categories.map(([icon,title,question,body],i)=><article><div class="category-top"><span class="category-icon"><Icon name={icon} size={28}/></span><span>0{i+1}</span></div><h3>{title}</h3><h4>{question}</h4><p>{body}</p></article>)}</div><a class="text-link" href="/coverage/">Understand our demo coverage <Icon name="arrow" size={18}/></a></div></section>
<section class="section container" id="how-it-works"><div class="section-intro"><div><span class="eyebrow">FROM CURIOUS TO INFORMED</span><h2>Three steps. A clearer next move.</h2></div><a class="text-link" href="#checker">Let’s check a car <Icon name="arrow" size={18}/></a></div><div class="steps"><article><span class="step-number">01</span><img class="step-art" src="/images/step1.png" alt="" width="1254" height="1254" loading="lazy" decoding="async"/><h3>Start with a VIN or plate.</h3><p>Enter the vehicle’s identifier.<br/>We’ll help you find it if you need a hand.</p></article><article><span class="step-number">02</span><img class="step-art" src="/images/step2.png" alt="" width="1254" height="1254" loading="lazy" decoding="async"/><h3>Make sure it’s your car.</h3><p>Review identity and coverage, then choose<br/>the report option that fits your search.</p></article><article><span class="step-number">03</span><img class="step-art" src="/images/step3.png" alt="" width="1254" height="1254" loading="lazy" decoding="async"/><h3>Read. Ask. Decide.</h3><p>Explore the records and take useful<br/>questions to the seller or mechanic.</p></article></div></section>
<section class="sample-section"><div class="container sample-inner"><div><span class="eyebrow">NO MYSTERY ABOUT WHAT’S INSIDE</span><h2>A history report.<br/>With a human side.</h2><p>Dated records, understandable findings, and questions worth asking. Here’s what that looks like.</p><div class="free-paid"><div><span class="mini-label">BEFORE YOU PAY</span><p>Vehicle identity and coverage details,<br/>when confirmed by the provider.</p></div><div><span class="mini-label">WITH A REPORT</span><p>Available history, a dated timeline,<br/>and a downloadable copy to keep.</p></div></div><a href="/sample-report/" class="button secondary">Explore the sample report <Icon name="arrow" size={18}/></a></div><a class="sample-sheet" href="/sample-report/" aria-label="Explore the synthetic sample report"><div class="sample-sheet-top"><span><Icon name="file"/> {config.name.toUpperCase()}</span><span class="status-tag">SYNTHETIC SAMPLE</span></div><h3>2019 Example Touring Sedan</h3><p class="small">The story, in a little more detail.</p><div class="sample-finding"><Icon name="alert"/><div><strong>Something to ask about</strong><p>Front-end damage recorded. Request repair invoices.</p></div></div><div class="mini-timeline"><div><span>2019</span><p>First registration <small>18 miles</small></p></div><div><span>2022</span><p>Odometer recorded <small>28,140 miles</small></p></div><div><span>2024</span><p>Damage entry <small>Repair details unknown</small></p></div><div><span>2026</span><p>Latest mileage <small>62,480 miles</small></p></div></div><div class="sheet-bottom">An example, not a real vehicle’s records <span>↗</span></div></a></div></section>
<section class="section container" id="pricing"><div class="center-heading"><span class="eyebrow">ONE CAR OR A FEW CONTENDERS?</span><h2>A clear price for a clearer picture.</h2><p>Pick what fits your search. Pay once. Keep your report.</p></div><PricingCards/></section>
<CustomerReviews/>
<section class="section container"><div class="section-intro"><div><span class="eyebrow">A LITTLE HOMEWORK GOES A LONG WAY</span><h2>Good questions start here.</h2></div><span class="small">THE BUYER’S NOTEBOOK</span></div><div class="guides-grid">{guides.map((guide,i)=><a class="guide" href={`/guides/${guide.slug}/`}><div class:list={['guide-art',`guide-art-${i}`]}><Icon name={['car','shield','gauge'][i]} size={82}/><span class="guide-art-label">FIELD NOTE / 0{i+1}</span><span class="guide-arrow">↗</span></div><span class="mini-label">{guide.tag} · {guide.read} MIN READ</span><h3>{guide.title}</h3><p>{guide.description}</p></a>)}</div></section>
<section class="faq-section container section" aria-labelledby="faq-heading"><div class="faq-intro"><span class="eyebrow">LET’S CLEAR A FEW THINGS UP</span><h2 id="faq-heading">A few good questions.</h2><p>Know what you’re getting,<br/>before you get started.</p><a class="text-link" href="/coverage/">More about coverage <span>↗</span></a></div><div class="faq-list">{faqs.map(f=><details><summary>{f.q}<span aria-hidden="true">＋</span></summary><p>{f.a}</p></details>)}</div><div class="faq-art"><img src="/images/Asking%20about%20a%20car%E2%80%99s%20history.png" alt="" width="1254" height="1254" loading="lazy" decoding="async" /></div></section>
<section class="final-cta"><div class="container"><span class="eyebrow">YOUR NEXT CAR HAS A STORY</span><h2>Get to know it<br/>before you call it yours.</h2><form class="final-checker" id="final-checker" action="/#checker"><label class="sr-only" for="final-vin">Enter your VIN number</label><input id="final-vin" name="vin" inputmode="text" autocomplete="off" spellcheck="false" maxlength="17" placeholder="Enter VIN number"/><button class="final-checker-submit" type="submit">Check my car <Icon name="arrow" size={20}/></button></form><span class="final-doodle" aria-hidden="true">↗</span></div></section><script>
 const finalForm=document.querySelector<HTMLFormElement>('#final-checker');
 finalForm?.addEventListener('submit',event=>{event.preventDefault();const field=finalForm.querySelector<HTMLInputElement>('#final-vin');if(!field)return;sessionStorage.setItem('vehicle-input',JSON.stringify({kind:'vin',vin:field.value,plate:'',state:''}));window.location.assign('/#checker');});
</script></Layout>
