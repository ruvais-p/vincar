---
import Layout from '../../layouts/Layout.astro';
import {guides} from '../../lib/content';
export function getStaticPaths(){return [...guides.map(g=>({params:{slug:g.slug}})),{params:{slug:'buying-checklist'}}];}
const guide=guides.find(g=>g.slug===Astro.params.slug);
const title=guide?.title||'Your used-car viewing checklist.';
const checks=['Match the VIN on the vehicle to the title and registration.','Read available damage and title records; write down any gaps.','Ask for service and repair invoices, with dates and mileage.','Compare the current odometer with documented readings.','Ask the manufacturer or an official recall service about open recalls.','Arrange an independent inspection and a safe test drive.','Confirm title, registration, insurance, and payment details before committing.'];
---
<Layout article title={title} description={guide?.description||'Take practical inspection and documentation questions to your next vehicle viewing.'}><article class="container content-page"><div class="page-heading"><div class="breadcrumb"><a href="/">Home</a><span>/ Buyer’s notebook</span></div><span class="eyebrow">{guide?.tag||'AT THE VIEWING'} · {guide?.read||3} MIN READ</span><h1>{title}</h1><p>{guide?.description||'A little preparation helps you make the most of a viewing. Check these off as you go.'}</p></div><div class="prose">{guide?guide.sections.map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>):<><p>This checklist is a starting point, not a guarantee of condition. Your selections are saved only in this browser tab.</p><ul class="checklist">{checks.map((check,i)=><li><label class="checkbox-label"><input type="checkbox" data-check={i}/><span>{check}</span></label></li>)}</ul><button class="button secondary" id="print-checklist">Print checklist</button></>}<p class="notice">A vehicle history report supports your investigation. It does not replace an independent inspection or official documents.</p><div class="actions"><a href="/sample-report/" class="button secondary">See the sample report →</a>{guide&&<a href="/guides/buying-checklist/">Open the buyer checklist</a>}</div><h2>Keep reading</h2>{guides.filter(g=>g!==guide).map(g=><p><a href={`/guides/${g.slug}/`}>{g.title}</a></p>)}</div></article><script>document.querySelectorAll<HTMLInputElement>('[data-check]').forEach(c=>{const key='checklist-'+c.dataset.check;c.checked=sessionStorage.getItem(key)==='true';c.addEventListener('change',()=>sessionStorage.setItem(key,String(c.checked)));});document.querySelector('#print-checklist')?.addEventListener('click',()=>window.print());</script></Layout>
