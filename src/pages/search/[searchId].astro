---
export const prerender=false;
import Layout from '../../layouts/Layout.astro';
import PricingCards from '../../components/PricingCards.astro';
import Icon from '../../components/Icon.astro';
import {db,findReport,activeCredits} from '../../lib/server';
import {config,date} from '../../lib/config';
const search=db.searches.get(Astro.params.searchId!);
if(!search||search.owner!==Astro.locals.owner)return new Response('Search not found.',{status:404});
const purchased=findReport(Astro.locals.owner,search);
const labels={received:'Your vehicle search',identified:'Vehicle identified',available:'History records available','no-match':'No matching vehicle',unsupported:'This market is not supported',failed:'The provider is temporarily unavailable'};
const credits=activeCredits(Astro.locals.owner);
---
<Layout title="Your vehicle search" privatePage><div class="container private-page"><div class="breadcrumb"><a href="/">Home</a><span>/ Your vehicle search</span></div><div class="search-heading"><div><span class="state-label">{labels[search.status]}</span><h1>{search.identity?`${search.identity.year} ${search.identity.make} ${search.identity.model}`:'Your vehicle search'}</h1><p class="identifier">{search.kind==='vin'?'VIN':'Plate'}: {search.input} {search.state}</p><p class="small">Search submitted: {date(search.submittedAt)}</p></div><a class="button secondary" href="/#checker">Edit search <Icon name="arrow" size={18}/></a></div>
<p class="notice">Demo — sample data, no live vehicle check. This identity and these outcomes are synthetic examples, not facts about the identifier you entered.</p>
{search.status==='available'?<><p>Sample category availability is confirmed by the demo adapter. A full report has not been generated {purchased?'for this search; an existing purchased report is available below.':'yet.'}</p><div class="preview-outline">{config.categories.map(c=><div><Icon name="lock"/>{c}</div>)}</div><p class="small">The fixture includes damage, title, mileage, and use examples. Recalls and listings are unavailable. Locked headings do not imply records exist.</p>{purchased?<div class="actions"><a class="button primary" href={`/reports/${purchased.id}/`}>Open your purchased report <Icon name="arrow"/></a><span class="small">No additional credit required.</span></div>:<>{credits>0&&<form method="post" action="/api/action/"><input type="hidden" name="action" value="credit"/><input type="hidden" name="search" value={search.id}/><div class="actions"><button class="button primary">Use 1 of {credits} available credits</button><span class="small">One report. No additional payment.</span></div></form>}<div class="center-heading"><h2>Choose a report option.</h2><p>One-time sandbox purchases. No real charges.</p></div><PricingCards searchId={search.id}/></>}</>:<div class="empty-state"><Icon name={search.status==='failed'?'alert':'search'} size={32}/><h2>{labels[search.status]}</h2><p>{search.status==='no-match'?'The demo provider returned no match. Check the identifier and state, or try a VIN instead of a plate. No payment is needed.':search.status==='unsupported'?'This demo is designed for standard-format US passenger vehicle identifiers. Older VINs and other markets need a specialist provider.':search.status==='identified'?'Vehicle identity alone does not confirm history coverage. No paid report is offered until the provider confirms availability.':'The provider could not complete this request. Your input is saved. Retry safely without making a payment.'}</p><div class="actions"><a class="button secondary" href="/#checker">Edit your input</a>{['failed','identified'].includes(search.status)&&<form method="post" action="/api/action/"><input type="hidden" name="action" value="retry-search"/><input type="hidden" name="search" value={search.id}/><button class="button primary">Retry with successful demo outcome</button></form>}</div></div>}
</div><script>import {track} from '../../lib/analytics';track('preview_viewed');if(document.querySelector('.preview-outline'))track('vehicle_identified');document.querySelectorAll('.plan a').forEach(a=>a.addEventListener('click',()=>track('plan_selected')));</script></Layout>
