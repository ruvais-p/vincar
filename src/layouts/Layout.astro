---
import '../styles/global.css';
import {config} from '../lib/config';
import Icon from '../components/Icon.astro';
const {title='Know the history before you buy.',description='Understand available vehicle records, compare your options, and ask better questions before buying a used car.',privatePage=false,article=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | {config.name}</title><meta name="description" content={description}/><meta name="referrer" content="strict-origin"/><meta name="robots" content={privatePage?'noindex, nofollow':'index, follow'}/>{!privatePage&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={`${title} | ${config.name}`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL('/social.svg',Astro.site)}/><meta name="theme-color" content="#F5F5EB"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>{!privatePage&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:config.name,url:Astro.site?.href})}/>}{!privatePage&&Astro.url.pathname!=='/'&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:Astro.site?.href},{'@type':'ListItem',position:2,name:title,item:canonical.href}]})}/>} {article&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:title,description,mainEntityOfPage:canonical.href,inLanguage:'en'})}/>}</head>
<body><a class="skip" href="#main">Skip to content</a><div class="demo-banner"><span class="demo-dot"></span> Demo — sample data, no live vehicle check <span class="desktop-only">· No real charges</span></div>
<header class="header"><div class="container nav-wrap"><a class="wordmark" href="/" aria-label={`${config.name} home`}><img class="brand-logo brand-logo-header" src="/images/vincar-logo-header.png" alt={config.name} width="2172" height="724" fetchpriority="high"/></a><button class="menu-toggle secondary" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">☰</span></button><nav id="navigation" aria-label="Main navigation"><details class="tools"><summary>Tools <span aria-hidden="true">⌄</span></summary><div class="tools-menu"><a href="/vin-decoder/">VIN decoder</a><a href="/license-plate-lookup/">License plate lookup</a></div></details><a href="/#how-it-works">How it works</a><a href="/pricing/">Pricing</a><a href="/sample-report/">Sample report</a><a class="nav-account" href="/account/"><Icon name="file" size={18}/> My reports <span aria-hidden="true">↗</span></a></nav></div></header>
<main id="main"><slot/></main>
<footer><div class="container footer-top"><div><a class="wordmark" href="/"><img class="brand-logo brand-logo-footer" src="/images/vincar-logo-footer.png" alt={config.name} width="2172" height="724" loading="lazy"/></a><p>A little history.<br/>A more informed next step.</p><span class="small">US demo · English · USD</span></div><div><h3>Explore</h3><a href="/vin-check/">Check a vehicle</a><a href="/sample-report/">Sample report</a><a href="/pricing/">Pricing</a><a href="/account/">My reports</a></div><div><h3>Get informed</h3><a href="/about/">About us</a><a href="/coverage/">Coverage & data</a><a href="/guides/buying-checklist/">Buyer checklist</a><a href="/support/">Help & support</a></div><div><h3>The details</h3><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/refund-policy/">Refund policy</a><a href="/accessibility/">Accessibility</a></div></div><div class="container footer-bottom"><span>© {new Date().getUTCFullYear()} {config.name}. Demo experience.</span><span>A history report supports, but never replaces, an independent inspection.</span></div></footer>
<script>
 const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle')!;
 const nav=document.querySelector<HTMLElement>('#navigation')!;
 function close(){toggle.setAttribute('aria-expanded','false');nav.classList.remove('open');}
 toggle.addEventListener('click',()=>{const expanded=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!expanded));nav.classList.toggle('open',!expanded);});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(nav.classList.contains('open')){close();toggle.focus();}document.querySelectorAll<HTMLDetailsElement>('details.tools[open]').forEach(d=>{d.open=false;d.querySelector('summary')?.focus();});}});
 nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
 document.addEventListener('click',e=>{document.querySelectorAll<HTMLDetailsElement>('details.tools[open]').forEach(d=>{if(!d.contains(e.target as Node))d.open=false;});});
 document.querySelectorAll<HTMLAnchorElement>('a[href="#checker"],a[href="/#checker"]').forEach(a=>a.addEventListener('click',()=>{setTimeout(()=>document.querySelector<HTMLInputElement>('#checker input:not([disabled])')?.focus({preventScroll:true}),150);}));
</script></body></html>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"/>
