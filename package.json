    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
